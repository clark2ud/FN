<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Evvls Docs</title>

<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #0b0b0d;
  --surface: #111114;
  --surface-2: #17171c;

  --border: rgba(255,255,255,.09);
  --border-strong: rgba(255,255,255,.16);

  --text: #fff;
  --muted: rgba(255,255,255,.45);
  --muted-strong: rgba(255,255,255,.62);

  --accent: #a89bff;
  --green: #8de0b0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 50% -20%,
      #272231 0%,
      transparent 42%
    ),
    var(--bg);

  color: var(--text);
  font-family: 'Syne', sans-serif;
}

button,
a {
  font: inherit;
}

button {
  cursor: pointer;
}

.app {
  width: 100%;
  max-width: 1120px;
  margin: auto;
  padding: 32px 28px 70px;
}

/* ========================================
   HEADER
======================================== */

header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 100px;
}

.logo {
  color: white;
  text-decoration: none;

  font-size: 22px;
  font-weight: 800;

  letter-spacing: -.5px;
}

.header-tag {
  font: 11px 'Space Mono', monospace;

  color: var(--muted);

  letter-spacing: 1px;
}

/* ========================================
   VIEWS
======================================== */

.view {
  display: none;

  animation: fade .45s ease both;
}

.view.active {
  display: block;
}

/* ========================================
   HERO
======================================== */

.hero {
  max-width: 650px;

  margin-bottom: 44px;
}

.eyebrow {
  font: 11px 'Space Mono', monospace;

  color: var(--accent);

  letter-spacing: 3px;

  text-transform: uppercase;

  margin-bottom: 18px;
}

h1 {
  font-size: clamp(38px, 6vw, 66px);

  font-weight: 800;

  letter-spacing: -2.5px;

  line-height: 1.02;
}

.hero p {
  color: var(--muted);

  font: 12px 'Space Mono', monospace;

  line-height: 1.8;

  margin-top: 22px;

  max-width: 500px;
}

/* ========================================
   GAME CARDS
======================================== */

.game-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 14px;

  max-width: 760px;
}

.game-card {
  position: relative;

  overflow: hidden;

  text-align: left;

  padding: 26px;

  min-height: 220px;

  border-radius: 18px;

  border: 1px solid var(--border);

  background:
    linear-gradient(
      145deg,
      #18181d,
      #0f0f12
    );

  color: white;

  transition:
    transform .25s,
    border-color .25s,
    background .25s;
}

.game-card:hover {
  transform: translateY(-4px);

  border-color:
    rgba(168,155,255,.55);

  background: #1b1921;
}

.game-card:focus-visible,
.action-btn:focus-visible,
.copy-btn:focus-visible,
.back-btn:focus-visible,
.sidebar button:focus-visible {
  outline: 2px solid var(--accent);

  outline-offset: 4px;
}

.game-icon {
  width: 48px;
  height: 48px;

  display: grid;

  place-items: center;

  font-size: 24px;

  background:
    rgba(255,255,255,.07);

  border:
    1px solid var(--border);

  border-radius: 13px;

  margin-bottom: 35px;
}

.game-card h2 {
  font-size: 23px;

  font-weight: 700;

  letter-spacing: -.6px;
}

.game-card p {
  color: var(--muted);

  font: 11px 'Space Mono', monospace;

  margin-top: 8px;

  line-height: 1.6;
}

.game-arrow {
  position: absolute;

  right: 24px;
  bottom: 24px;

  color: var(--muted);

  font-size: 20px;
}

/* ========================================
   DOC LAYOUT
======================================== */

.docs-layout {
  display: grid;

  grid-template-columns:
    210px minmax(0, 1fr);

  gap: 60px;

  align-items: start;
}

.sidebar {
  position: sticky;

  top: 28px;
}

.sidebar-label {
  font: 10px 'Space Mono', monospace;

  color: var(--muted);

  letter-spacing: 2px;

  text-transform: uppercase;

  margin-bottom: 18px;
}

.sidebar button {
  display: block;

  width: 100%;

  text-align: left;

  border: none;

  border-left:
    1px solid var(--border);

  background: transparent;

  color: var(--muted);

  padding: 10px 14px;

  font: 11px 'Space Mono', monospace;

  transition:
    color .2s,
    background .2s,
    border-color .2s;
}

.sidebar button:hover,
.sidebar button.active {
  color: white;

  border-left-color:
    var(--accent);

  background:
    rgba(168,155,255,.07);
}

.docs-main {
  min-width: 0;
}

/* ========================================
   DOC TOP
======================================== */

.docs-top {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 14px;

  margin-bottom: 44px;
}

.back-btn,
.action-btn {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  color: var(--muted);

  background: transparent;

  border:
    1px solid var(--border);

  padding: 10px 14px;

  border-radius: 9px;

  font: 11px 'Space Mono', monospace;

  text-decoration: none;

  transition:
    color .2s,
    border-color .2s,
    background .2s;
}

.back-btn:hover,
.action-btn:hover {
  color: white;

  border-color:
    var(--border-strong);

  background:
    rgba(255,255,255,.035);
}

/* ========================================
   DOC TITLE
======================================== */

.docs-title {
  margin-bottom: 70px;
}

.docs-title h1 {
  font-size:
    clamp(30px, 4vw, 48px);

  letter-spacing: -1.5px;
}

.docs-title p {
  color: var(--muted);

  font: 11px 'Space Mono', monospace;

  line-height: 1.8;

  margin-top: 14px;

  max-width: 650px;
}

/* ========================================
   SECTIONS
======================================== */

.docs-section {
  scroll-margin-top: 35px;

  margin-bottom: 90px;
}

.section-kicker {
  font: 10px 'Space Mono', monospace;

  color: var(--accent);

  letter-spacing: 2px;

  text-transform: uppercase;

  margin-bottom: 14px;
}

.docs-section h2 {
  font-size: 26px;

  letter-spacing: -.8px;

  margin-bottom: 12px;
}

.docs-section > p {
  color: var(--muted);

  font: 12px 'Space Mono', monospace;

  line-height: 1.9;

  margin-bottom: 34px;
}

/* ========================================
   BLOCK
======================================== */

.doc-block {
  margin-top: 38px;
}

.block-title {
  font-size: 18px;

  font-weight: 700;

  letter-spacing: -.3px;

  margin-bottom: 14px;
}

/* ========================================
   CODE CARD
======================================== */

.code-card {
  overflow: hidden;

  border:
    1px solid var(--border);

  border-radius: 13px;

  background: #0e0e11;

  margin: 0;
}

.code-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 12px;

  padding: 12px 15px;

  background: #151519;

  border-bottom:
    1px solid var(--border);
}

.code-language {
  font: 10px 'Space Mono', monospace;

  color: var(--muted);
}

.copy-btn {
  border:
    1px solid var(--border);

  background:
    rgba(255,255,255,.04);

  border-radius: 7px;

  color: var(--muted);

  font: 10px 'Space Mono', monospace;

  padding: 6px 10px;

  transition:
    color .2s,
    background .2s,
    border-color .2s;
}

.copy-btn:hover {
  color: white;

  background:
    rgba(255,255,255,.1);

  border-color:
    var(--border-strong);
}

.copy-btn.copied {
  color: var(--green);

  border-color:
    rgba(141,224,176,.3);
}

/* ========================================
   CODE
======================================== */

.code-card pre {
  overflow-x: auto;

  padding: 22px;

  margin: 0;

  background: #0e0e11;

  font:
    12px/1.9
    'Space Mono',
    monospace;

  tab-size: 4;

  white-space: pre;
}

.code-card code {
  font-family:
    'Space Mono',
    monospace;

  color: #d7d4e3;
}

/* ========================================
   SYNTAX COLORS
======================================== */

.syntax-comment {
  color: #666673;

  font-style: italic;
}

.syntax-keyword {
  color: #c4b5fd;
}

.syntax-type {
  color: #93c5fd;
}

.syntax-function {
  color: #8de0b0;
}

.syntax-string {
  color: #a8d8a8;
}

.syntax-number {
  color: #f0b38a;
}

.syntax-preprocessor {
  color: #f3b6ff;
}

.syntax-constant {
  color: #f0b38a;
}

.syntax-operator {
  color: #d7d4e3;
}

.syntax-punctuation {
  color: #aaa7b7;
}

.syntax-property {
  color: #93c5fd;
}

/* ========================================
   EXPLANATION
======================================== */

.explanation {
  margin-top: 22px;

  padding: 25px 26px;

  border:
    1px solid var(--border);

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.035),
      rgba(255,255,255,.018)
    );

  box-shadow:
    0 10px 30px
    rgba(0,0,0,.12);
}

.explanation-title {
  display: flex;

  align-items: center;

  gap: 9px;

  font-size: 12px;

  font-weight: 700;

  margin-bottom: 13px;
}

.explanation-title::before {
  content: "?";

  width: 20px;
  height: 20px;

  display: grid;

  place-items: center;

  border-radius: 6px;

  background:
    rgba(168,155,255,.1);

  border:
    1px solid
    rgba(168,155,255,.2);

  color: var(--accent);

  font:
    10px
    'Space Mono',
    monospace;
}

.explanation p {
  font:
    11px/1.9
    'Space Mono',
    monospace;

  color: var(--muted-strong);

  margin-bottom: 17px;
}

.explanation ul {
  padding-left: 19px;
}

.explanation li {
  font:
    11px/1.9
    'Space Mono',
    monospace;

  color: var(--muted);

  margin-bottom: 5px;
}

.explanation li:last-child {
  margin-bottom: 0;
}

/* ========================================
   FOOTER
======================================== */

footer {
  margin-top: 80px;

  color:
    rgba(255,255,255,.25);

  text-align: center;

  font:
    11px
    'Space Mono',
    monospace;
}

/* ========================================
   ANIMATION
======================================== */

@keyframes fade {

  from {
    opacity: 0;

    transform:
      translateY(14px);
  }

  to {
    opacity: 1;

    transform:
      translateY(0);
  }

}

/* ========================================
   MOBILE
======================================== */

@media (max-width: 700px) {

  .app {
    padding:
      24px 18px 50px;
  }

  header {
    margin-bottom: 65px;
  }

  .game-grid {
    grid-template-columns: 1fr;
  }

  .docs-layout {
    grid-template-columns: 1fr;

    gap: 35px;
  }

  .sidebar {
    position: static;

    display: flex;

    gap: 8px;

    overflow-x: auto;

    padding-bottom: 4px;
  }

  .sidebar-label {
    display: none;
  }

  .sidebar button {
    width: auto;

    white-space: nowrap;

    border-left: none;

    border-bottom:
      1px solid var(--border);

    border-radius:
      4px 4px 0 0;
  }

  .sidebar button.active {
    border-bottom-color:
      var(--accent);
  }

  .docs-top {
    margin-bottom: 30px;
  }

  .docs-title {
    margin-bottom: 55px;
  }

  .docs-section {
    margin-bottom: 70px;
  }

  .doc-block {
    margin-top: 30px;
  }

  .block-title {
    font-size: 16px;
  }

  .explanation {
    padding: 21px;

    margin-top: 18px;
  }

  .code-card pre {
    padding: 18px;

    font-size: 11px;
  }

  h1 {
    letter-spacing: -1.5px;
  }

}
</style>
</head>

