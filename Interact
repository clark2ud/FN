end

addCoins(10)

print(coins)`,

            description:
              "This example stores a coin count and increases it using a reusable function.",

            points: [
              "local creates a variable.",
              "function defines reusable logic.",
              "The function adds the supplied amount."
            ]

          },


          {

            title: "Simple Function",

            language: "Luau",

            code:
`local function greet(name)
