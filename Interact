/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHTML(value) {

  return String(value)

    .replace(
      /&/g,
      "&amp;"
    )

    .replace(
      /</g,
      "&lt;"
    )

    .replace(
      />/g,
      "&gt;"
    )

    .replace(
      /"/g,
      "&quot;"
    )

    .replace(
      /'/g,
      "&#039;"
    );

}


/* =====================================================
   TOKENIZER
===================================================== */

function highlightCode(source, language) {

  if (!source) {
    return "";
  }

  const tokens = [];

  function protect(type, value) {

    const id =
      `___EVVLS_TOKEN_${tokens.length}___`;

    tokens.push({
      id: id,

      html:
        `<span class="${type}">${escapeHTML(value)}</span>`
    });

    return id;
  }


  let code = source;


  /* ==========================================
     COMMENTS
  ========================================== */

  code = code.replace(
    /\/\/.*$/gm,

    match =>
      protect(
        "syntax-comment",
        match
      )
  );


  code = code.replace(
    /\/\*[\s\S]*?\*\//g,

    match =>
      protect(
        "syntax-comment",
        match
      )
  );


  /* ==========================================
     STRINGS
  ========================================== */

  code = code.replace(
    /"(?:\\.|[^"\\])*"/g,

    match =>
      protect(
        "syntax-string",
        match
      )
  );


  code = code.replace(
    /'(?:\\.|[^'\\])*'/g,

    match =>
      protect(
        "syntax-string",
        match
      )
  );


  /* ==========================================
     PREPROCESSOR
  ========================================== */

  code = code.replace(
    /^\s*#\s*[a-zA-Z_]\w*(?:.*)$/gm,

    match =>
      protect(
        "syntax-preprocessor",
        match
      )
  );


  /* ==========================================
     ESCAPE HTML
  ========================================== */

  code =
    escapeHTML(code);


  /* ==========================================
     C++ KEYWORDS
  ========================================== */

  const cppKeywords = [

    "alignas",
    "alignof",
    "asm",
    "auto",
    "break",
    "case",
    "catch",
    "class",
    "const",
    "constexpr",
    "consteval",
    "constinit",
    "const_cast",
    "continue",
    "decltype",
    "default",
    "delete",
    "do",
    "dynamic_cast",
    "else",
    "enum",
    "explicit",
    "export",
    "extern",
    "false",
    "for",
    "friend",
    "goto",
    "if",
    "inline",
    "mutable",
    "namespace",
    "new",
    "noexcept",
    "nullptr",
    "operator",
    "private",
    "protected",
    "public",
    "reinterpret_cast",
    "return",
    "static",
    "static_assert",
    "static_cast",
    "struct",
    "switch",
    "template",
    "this",
    "throw",
    "true",
    "try",
    "typedef",
    "typeid",
    "typename",
    "union",
    "using",
    "virtual",
    "void",
    "volatile",
    "while"
  ];


  /* ==========================================
     LUA KEYWORDS
  ========================================== */

  const luaKeywords = [

    "and",
    "break",
    "do",
    "else",
    "elseif",
    "end",
    "false",
    "for",
    "function",
    "if",
    "in",
    "local",
    "nil",
    "not",
    "or",
    "repeat",
    "return",
    "then",
    "true",
    "until",
    "while"
  ];


  const keywords =
    language.toLowerCase() === "luau"
      ? luaKeywords
      : cppKeywords;


  const keywordRegex =
    new RegExp(
      `\\b(${keywords.join("|")})\\b`,
      "g"
    );


  code =
    code.replace(
      keywordRegex,

      match =>
        `<span class="syntax-keyword">${match}</span>`
    );


  /* ==========================================
     TYPES
  ========================================== */

  const types = [

    "bool",
    "char",
    "char8_t",
    "char16_t",
    "char32_t",
    "double",
    "float",
    "int",
    "long",
    "short",
    "signed",
    "size_t",
    "uint8_t",
    "uint16_t",
    "uint32_t",
    "uint64_t",
    "int8_t",
    "int16_t",
    "int32_t",
    "int64_t",
    "uintptr_t",
    "unsigned",
    "void",
    "wchar_t",

    "Vector2",
    "Vector3",
    "Vector4",
    "FTransform",
    "D3DMATRIX",

    "std",
    "string",
    "vector",
    "array",
    "map",
    "unordered_map",
    "unique_ptr",
    "shared_ptr",

    "Instance",
    "Folder",
    "IntValue"
  ];


  const typeRegex =
    new RegExp(
      `\\b(${types.join("|")})\\b`,
      "g"
    );


  code =
    code.replace(
      typeRegex,

      match =>
        `<span class="syntax-type">${match}</span>`
    );


  /* ==========================================
     NUMBERS
  ========================================== */

  code =
    code.replace(

      /\b(?:0x[0-9a-fA-F]+|\d+(?:\.\d+)?(?:f|u|ll|ull)?)\b/g,

      match =>
        `<span class="syntax-number">${match}</span>`
    );


  /* ==========================================
     FUNCTIONS
  ========================================== */

  code =
    code.replace(

      /\b[A-Za-z_]\w*(?=\s*\()/g,

      match => {

        if (
          match.includes("syntax-")
        ) {
          return match;
        }

        return `
          <span class="syntax-function">
            ${match}
          </span>
        `;
      }

    );


  /* ==========================================
     CONSTANTS
  ========================================== */

  code =
    code.replace(

      /\b(NULL|TRUE|FALSE|M_PI)\b/g,

      match =>
        `<span class="syntax-constant">${match}</span>`
    );


  /* ==========================================
     OPERATORS
  ========================================== */

  code =
    code.replace(

      /(&gt;=|&lt;=|==|!=|&&|\|\||\+\+|--|::|->|<<|>>|\+=|-=|\*=|\/=|%=|=|\+|-|\*|\/|%|&lt;|&gt;|!|&amp;|\|)/g,

      match =>
        `<span class="syntax-operator">${match}</span>`
    );


  /* ==========================================
     RESTORE TOKENS
  ========================================== */

  tokens.forEach(token => {

    code =
      code.replaceAll(
        token.id,
        token.html
      );

  });


  return code;

}


/* =====================================================
   VIEW SWITCH
===================================================== */

function showView(view) {

  selection.classList.toggle(
    "active",
    view === "selection"
  );

  documentation.classList.toggle(
    "active",
    view === "documentation"
  );

  window.scrollTo({

    top: 0,

    behavior: "smooth"

  });

}


/* =====================================================
   SIDEBAR
===================================================== */

function renderSidebar(sections) {

  sidebarLinks.innerHTML = "";

  sections.forEach(
    (section, index) => {

      const button =
        document.createElement("button");

      button.type =
        "button";

      button.className =
        "side-link" +
        (index === 0
          ? " active"
          : "");

      button.dataset.target =
        section.id;

      button.textContent =
        section.title;


      button.addEventListener(
        "click",

        () => {

          document
            .querySelectorAll(
              ".side-link"
            )
            .forEach(btn => {

              btn.classList.remove(
                "active"
              );

            });


          button.classList.add(
            "active"
          );


          const target =
            document.getElementById(
              section.id
            );


          if (!target) {
            return;
          }


          target.scrollIntoView({

            behavior: "smooth",

            block: "start"

          });

        }
      );


      sidebarLinks.appendChild(
        button
      );

    }
  );

}


/* =====================================================
   COPY
===================================================== */

async function copyCode(
  button,
  code
) {

  try {

    await navigator
      .clipboard
      .writeText(code);


    const original =
      button.textContent;


    button.textContent =
      "Copied";


    button.classList.add(
      "copied"
    );


    setTimeout(
      () => {

        button.textContent =
          original;

        button.classList.remove(
          "copied"
        );

      },

      1400
    );


  } catch (error) {

    console.error(
      "Clipboard failed:",
      error
    );


    button.textContent =
      "Failed";


    setTimeout(
      () => {

        button.textContent =
          "Copy";

      },

      1400
    );

  }

}


/* =====================================================
   RENDER DOCUMENTATION
===================================================== */

function renderDocs(gameKey) {

  const game =
    templates[gameKey];


  if (!game) {
    return;
  }


  currentGame =
    gameKey;


  docsHeading.textContent =
    game.title;


  docsDescription.textContent =
    game.description;


  docsLabel.textContent =
    game.label;


  docsEyebrow.textContent =
    game.label +
    " / DOCS";


  content.innerHTML =
    "";


  renderSidebar(
    game.sections
  );


  game.sections.forEach(
    section => {

      const sectionEl =
        document.createElement(
          "section"
        );


      sectionEl.className =
        "docs-section";


      sectionEl.id =
        section.id;


      sectionEl.innerHTML = `

        <div class="section-kicker">
          ${escapeHTML(section.kicker)}
        </div>

        <h2>
          ${escapeHTML(section.title)}
        </h2>

        <p>
          ${escapeHTML(section.description)}
        </p>

      `;


      section.blocks.forEach(
        block => {

          const blockWrapper =
            document.createElement(
              "article"
            );


          blockWrapper.className =
            "doc-block";


          /* TITLE */

          const title =
            document.createElement(
              "div"
            );


          title.className =
            "block-title";


          title.textContent =
            block.title;


          /* CODE CARD */

          const codeCard =
            document.createElement(
              "div"
            );


          codeCard.className =
            "code-card";


          /* HEADER */

          const codeHeader =
            document.createElement(
              "div"
            );


          codeHeader.className =
            "code-header";


          /* LANGUAGE */

          const language =
            document.createElement(
              "span"
            );


          language.className =
            "code-language";


          language.textContent =
            block.language;


          /* COPY */

          const copyButton =
            document.createElement(
              "button"
            );


          copyButton.type =
            "button";


          copyButton.className =
            "copy-btn";


          copyButton.textContent =
            "Copy";


          copyButton.addEventListener(
            "click",

            () => {

              copyCode(
                copyButton,
                block.code
              );

            }
          );


          codeHeader.append(
            language,
            copyButton
          );


          /* PRE */

          const pre =
            document.createElement(
              "pre"
            );


          /* CODE */

          const code =
            document.createElement(
              "code"
            );


          code.className =
            "evvls-code";


          code.innerHTML =
            highlightCode(
              block.code,
              block.language
            );


          pre.appendChild(
            code
          );


          codeCard.append(
            codeHeader,
            pre
          );


          /* =====================================
             EXPLANATION
          ===================================== */

          const explanation =
            document.createElement(
              "div"
            );


          explanation.className =
            "explanation";


          const explanationTitle =
            document.createElement(
              "div"
            );


          explanationTitle.className =
            "explanation-title";


          explanationTitle.textContent =
            "What does this do?";


          const explanationText =
            document.createElement(
              "p"
            );


          explanationText.textContent =
            block.description;


          const list =
            document.createElement(
              "ul"
            );


          block.points.forEach(
            point => {

              const li =
                document.createElement(
                  "li"
                );


              li.textContent =
                point;


              list.appendChild(
                li
              );

            }
          );


          explanation.append(
            explanationTitle,
            explanationText,
            list
          );


          /* =====================================
             FINAL APPEND
          ===================================== */

          blockWrapper.append(
            title,
            codeCard,
            explanation
          );


          sectionEl.appendChild(
            blockWrapper
          );

        }
      );


      content.appendChild(
        sectionEl
      );

    }
  );


  showView(
    "documentation"
  );


  requestAnimationFrame(
    setupScrollSpy
  );

}


/* =====================================================
   SCROLL SPY
===================================================== */

function setupScrollSpy() {

  const sections =
    document.querySelectorAll(
      ".docs-section"
    );


  const links =
    document.querySelectorAll(
      ".side-link"
    );


  if (!sections.length) {
    return;
  }


  const observer =
    new IntersectionObserver(

      entries => {

        const visible =
          entries

            .filter(
              entry =>
                entry.isIntersecting
            )

            .sort(
              (a, b) =>
                b.intersectionRatio -
                a.intersectionRatio
            );


        if (!visible.length) {
          return;
        }


        const activeId =
          visible[0]
            .target
            .id;


        links.forEach(
          link => {

            link.classList.toggle(

              "active",

              link.dataset.target ===
              activeId

            );

          }
        );

      },

      {

        rootMargin:
          "-15% 0px -65% 0px",

        threshold: [
          0,
          0.1,
          0.25,
          0.5
        ]

      }

    );


  sections.forEach(
    section =>
      observer.observe(section)
  );

}


