              "player.Name contains the player's username."
            ]

          },


          {

            title: "Getting a Player",

            language: "Luau",

            code:
`local Players = game:GetService("Players")

local players = Players:GetPlayers()
local player = players[1]

if player then
    print(player.Name)
end`,

            description:
              "This retrieves the first player currently connected to the server.",

            points: [
              "GetPlayers returns the players currently in the server.",
              "The first player is accessed using index 1.",
              "The if statement prevents accessing a missing player."
