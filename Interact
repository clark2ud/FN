          }

        ]

      },


      {

        id: "systems",

        kicker: "03 / SYSTEMS",

        title: "Creating a Basic System",

        description:
          "Use server-side scripts to manage game state and gameplay events.",

        blocks: [

          {

            title: "Player Score",

