function renderSidebar(sections) {
  sidebarLinks.innerHTML = "";
  sections.forEach((section, index) => {
    const button =
      document.createElement("button");
    button.type = "button";
    button.className =
      "side-link" +
      (index === 0 ? " active" : "");
    button.dataset.target =
      section.id;
    button.textContent =
      section.title;
    button.addEventListener(
      "click",
      () => {
        document
          .querySelectorAll(".side-link")
          .forEach(btn => {
            btn.classList.remove("active");
          });
        button.classList.add("active");
        const target =
          document.getElementById(section.id);
        if (!target) return;
        target.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }
    );
    sidebarLinks.appendChild(button);
  });
}
async function copyCode(button, code) {
  try {
    await navigator.clipboard.writeText(code);
    const original =
      button.textContent;
    button.textContent =
      "Copied";
    button.classList.add("copied");
    setTimeout(() => {
      button.textContent =
        original;
      button.classList.remove("copied");
    }, 1400);
  } catch (error) {
    console.error(
      "Clipboard failed:",
      error
    );
    button.textContent =
      "Failed";
    setTimeout(() => {
      button.textContent =
        "Copy";
    }, 1400);
  }
}
function renderDocs(gameKey) {
  const game =
    templates[gameKey];
  if (!game) return;
  currentGame =
    gameKey;
  docsHeading.textContent =
    game.title;
  docsDescription.textContent =
    game.description;
  docsLabel.textContent =
    game.label;
  docsEyebrow.textContent =
    game.label + " / DOCS";
  content.innerHTML = "";
  renderSidebar(
    game.sections
  );
  game.sections.forEach(
    section => {
      const sectionEl =
        document.createElement("section");
      sectionEl.className =
        "docs-section";
      sectionEl.id =
        section.id;
      sectionEl.innerHTML = `
        <div class="section-kicker">
          ${escapeHTML(section.kicker)}
        </div>
        <h2>
          ${escapeHTML(section.title)}
        </h2>
        <p>
          ${escapeHTML(section.description)}
        </p>
      `;
      section.blocks.forEach(
        block => {
          const blockWrapper =
            document.createElement("article");
          blockWrapper.className =
            "doc-block";
          const title =
            document.createElement("div");
          title.className =
            "block-title";
          title.textContent =
            block.title;
          const codeCard =
            document.createElement("div");
          codeCard.className =
            "code-card";
          const codeHeader =
            document.createElement("div");
          codeHeader.className =
            "code-header";
          const language =
            document.createElement("span");
          language.className =
            "code-language";
          language.textContent =
            block.language;
          const copyButton =
            document.createElement("button");
          copyButton.type =
            "button";
          copyButton.className =
            "copy-btn";
          copyButton.textContent =
            "Copy";
          copyButton.addEventListener(
            "click",
            () => {
              copyCode(
                copyButton,
                block.code
              );
            }
          );
          codeHeader.append(
            language,
            copyButton
          );
          const pre =
            document.createElement("pre");
          const code =
            document.createElement("code");
          code.textContent =
            block.code;
          pre.appendChild(code);
          codeCard.append(
            codeHeader,
            pre
          );
          const explanation =
            document.createElement("div");
          explanation.className =
            "explanation";
          const explanationTitle =
            document.createElement("div");
          explanationTitle.className =
            "explanation-title";
          explanationTitle.textContent =
            "What does this do?";
          const explanationText =
            document.createElement("p");
          explanationText.textContent =
            block.description;
          const list =
            document.createElement("ul");
          block.points.forEach(
            point => {
              const li =
                document.createElement("li");
              li.textContent =
                point;
              list.appendChild(li);
            }
          );
          explanation.append(
            explanationTitle,
            explanationText,
            list
          );
          blockWrapper.append(
            title,
            codeCard,
            explanation
          );
          sectionEl.appendChild(
            blockWrapper
          );
        }
      );
      content.appendChild(
        sectionEl
      );
    }
  );
  showView(
    "documentation"
  );
}
document
  .querySelectorAll(".game-card")
  .forEach(card => {
    card.addEventListener(
      "click",
      () => {
        renderDocs(
          card.dataset.game
        );
      }
    );
  });
backButton.addEventListener(
  "click",
  () => {
    showView(
      "selection"
    );
  }
);
logo.addEventListener(
  "click",
  event => {
    event.preventDefault();
    showView(
      "selection"
    );
  }
);
function setupScrollSpy() {
  const sections =
    document.querySelectorAll(
      ".docs-section"
    );
  const links =
    document.querySelectorAll(
      ".side-link"
    );
  if (!sections.length) return;
  const observer =
    new IntersectionObserver(
      entries => {
        const visible =
          entries
            .filter(entry => entry.isIntersecting)
            .sort(
              (a, b) =>
                b.intersectionRatio -
                a.intersectionRatio
            );
        if (!visible.length) return;
        const activeId =
          visible[0].target.id;
        links.forEach(link => {
          link.classList.toggle(
            "active",
            link.dataset.target === activeId
          );
        });
      },
      {
        rootMargin:
          "-15% 0px -65% 0px",
        threshold: [
          0,
          0.1,
          0.25,
          0.5
        ]
      }
    );
  sections.forEach(
    section => observer.observe(section)
  );
}
const originalRenderDocs =
  renderDocs;
window.renderDocs =
  function(gameKey) {
    originalRenderDocs(gameKey);
    requestAnimationFrame(() => {
      setupScrollSpy();
    });
  };
document
  .querySelectorAll(".game-card")
  .forEach(card => {
    card.onclick = () => {
      window.renderDocs(
        card.dataset.game
      );
    };
  });
</script>
