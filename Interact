const templates = {

  roblox: {

    label: "ROBLOX",

    title: "Roblox Development",

    description:
      "Learn Luau scripting and the foundations of Roblox Studio.",

    sections: [

      {

        id: "intro",

        kicker: "01 / INTRODUCTION",

        title: "Getting Started",

        description:
          "Scripts let you control gameplay, events, and game systems inside Roblox Studio.",

        blocks: [

          {

