                        <button onclick="closeWindow('${winId}', '${appId}')" class="w-8 h-8 rounded hover:bg-red-600 flex items-center justify-center text-zinc-300 hover:text-white"><i class="fa-solid fa-xmark text-xs"></i></button>
                    </div>
                </div>
                <div class="flex-1 overflow-auto bg-zinc-950/40 text-zinc-100 flex flex-col">
                    ${config.content}
                </div>
            `;

            winEl.onmousedown = () => focusWindow(appId);
            document.getElementById('windowsContainer').appendChild(winEl);
            windows[appId] = { id: winId, el: winEl, isMax: false, prevRect: null };
            activeWindowId = appId;

            if(appId === 'terminal') initTerminal();
            if(appId === 'calculator') initCalculator();
            if(appId === 'taskmgr') initTaskMgr();
        }

        function focusWindow(appId) {
            zIndexCounter++;
            if (windows[appId]) {
                windows[appId].el.style.zIndex = zIndexCounter;
                activeWindowId = appId;
            }
        }

        function closeWindow(winId, appId) {
            const el = document.getElementById(winId);
            if (el) el.remove();
            delete windows[appId];
        }

        function minimizeWindow(winId) {
            const el = document.getElementById(winId);
            if (el) el.style.display = 'none';
        }

        function maximizeWindow(winId) {
            const win = Object.values(windows).find(w => w.id === winId);
            if (!win) return;
            const el = win.el;
            if (!win.isMax) {
                win.prevRect = { left: el.style.left, top: el.style.top, width: el.style.width, height: el.style.height };
                el.style.left = '0px';
                el.style.top = '0px';
                el.style.width = '100vw';
                el.style.height = 'calc(100vh - 48px)';
                el.style.borderRadius = '0px';
                win.isMax = true;
            } else {
                el.style.left = win.prevRect.left;
                el.style.top = win.prevRect.top;
                el.style.width = win.prevRect.width;
                el.style.height = win.prevRect.height;
                el.style.borderRadius = '0.75rem';
                win.isMax = false;
            }
        }

        // Window Draggable Logic
        let draggingWin = null;
        let dragOffsetX = 0, dragOffsetY = 0;

        function startDrag(e, winId) {
            if (e.target.tagName === 'BUTTON' || e.target.closest('button')) return;
            draggingWin = document.getElementById(winId);
            const rect = draggingWin.getBoundingClientRect();
            dragOffsetX = e.clientX - rect.left;
            dragOffsetY = e.clientY - rect.top;

            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup', stopDrag);
        }

        function onDrag(e) {
            if (!draggingWin) return;
            draggingWin.style.left = (e.clientX - dragOffsetX) + 'px';
            draggingWin.style.top = Math.max(0, e.clientY - dragOffsetY) + 'px';
        }

        function stopDrag() {
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup', stopDrag);
            draggingWin = null;
        }

