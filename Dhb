                        <button onclick="calcBtn('+')" class="p-3 bg-white/10 rounded hover:bg-white/20">+</button>
                        <button onclick="calcBtn('0')" class="col-span-2 p-3 bg-white/5 rounded hover:bg-white/15">0</button>
                        <button onclick="calcBtn('.')" class="p-3 bg-white/5 rounded hover:bg-white/15">.</button>
                        <button onclick="calcBtn('=')" class="p-3 bg-blue-600 rounded hover:bg-blue-700">=</button>
                    </div>
                </div>
            `;
        }

        let calcExpr = '0';
        function calcBtn(val) {
            if (val === 'C') {
                calcExpr = '0';
            } else if (val === '=') {
                try {
                    calcExpr = String(eval(calcExpr.replace(/×/g, '*').replace(/÷/g, '/')));
                } catch {
                    calcExpr = 'Error';
                }
            } else {
                if (calcExpr === '0' || calcExpr === 'Error') calcExpr = val;
                else calcExpr += val;
            }
            document.getElementById('calcDisplay').innerText = calcExpr;
        }

        function getTaskMgrHTML() {
            return `
                <div class="p-6 text-xs">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-sm font-semibold">Processes</h3>
                        <span id="cpuUsage" class="text-emerald-400 font-mono">CPU: 12% | RAM: 4.2 GB</span>
                    </div>
                    <table class="w-full text-left">
                        <thead>
                            <tr class="border-b border-white/10 text-zinc-400">
                                <th class="pb-2">Name</th>
                                <th class="pb-2">CPU</th>
                                <th class="pb-2">Memory</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 font-mono">
                            <tr><td class="py-2">explorer.exe</td><td>1.2%</td><td>128 MB</td></tr>
                            <tr><td class="py-2">msedge.exe</td><td>4.5%</td><td>850 MB</td></tr>
                            <tr><td class="py-2">Code.exe</td><td>2.1%</td><td>610 MB</td></tr>
                            <tr><td class="py-2">Spotify.exe</td><td>0.8%</td><td>240 MB</td></tr>
                            <tr><td class="py-2">WindowsTerminal.exe</td><td>0.1%</td><td>45 MB</td></tr>
                        </tbody>
                    </table>
                </div>
            `;
        }

        function initTaskMgr() {
            setInterval(() => {
                const cpu = Math.floor(Math.random() * 15) + 8;
                const el = document.getElementById('cpuUsage');
                if (el) el.innerText = `CPU: ${cpu}% | RAM: 4.2 GB`;
            }, 2000);
        }
    </script>
</body>
</html>
