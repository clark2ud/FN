        function openApp(appId) {
            if (windows[appId]) {
                focusWindow(appId);
                return;
            }
            const config = appConfigs[appId];
            if (!config) return;

            zIndexCounter++;
            const winId = 'win_' + appId;
            const winEl = document.createElement('div');
            winEl.id = winId;
            winEl.className = 'absolute pointer-events-auto rounded-xl acrylic-dark window-shadow flex flex-col overflow-hidden transition-shadow duration-200';
            winEl.style.width = config.w + 'px';
            winEl.style.height = config.h + 'px';
