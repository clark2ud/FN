    <style>
        body {
            font-family: 'Inter', sans-serif;
            user-select: none;
            overflow: hidden;
            background: url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2560&auto=format&fit=crop') no-repeat center center fixed;
            background-size: cover;
        }
        .acrylic-dark {
            background: rgba(32, 32, 32, 0.82);
            backdrop-filter: blur(30px) saturate(180%);
            -webkit-backdrop-filter: blur(30px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .acrylic-light {
            background: rgba(245, 245, 245, 0.85);
            backdrop-filter: blur(30px) saturate(180%);
            -webkit-backdrop-filter: blur(30px) saturate(180%);
            border: 1px solid rgba(0, 0, 0, 0.1);
        }
        .acrylic-taskbar {
            background: rgba(24, 24, 24, 0.75);
            backdrop-filter: blur(40px) saturate(200%);
            -webkit-backdrop-filter: blur(40px) saturate(200%);
            border-top: 1px solid rgba(255, 255, 255, 0.12);
        }
        .acrylic-taskbar-light {
            background: rgba(240, 240, 240, 0.78);
            backdrop-filter: blur(40px) saturate(200%);
            -webkit-backdrop-filter: blur(40px) saturate(200%);
            border-top: 1px solid rgba(0, 0, 0, 0.1);
        }
        .window-shadow {
            box-shadow: 0 10px 30px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,255,255,0.08) inset;
        }
        .window-shadow-light {
            box-shadow: 0 10px 30px rgba(0,0,0,0.15), 0 0 0 1px rgba(0,0,0,0.05) inset;
        }
        .app-icon-hover:hover {
            background: rgba(255, 255, 255, 0.12);
        }
        .app-icon-hover-light:hover {
            background: rgba(0, 0, 0, 0.08);
        }
        /* Hide scrollbars for clean Win11 look */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(150, 150, 150, 0.4);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(150, 150, 150, 0.7);
        }
    </style>
</head>
