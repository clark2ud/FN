            TranslateMessage( &messager );
            DispatchMessage( &messager );
        }

        if ( !game_wnd || !IsWindow( game_wnd ) )
        {
            game_wnd = get_process_wnd( ClarkDtcDriver::ProcessID );
            Sleep( 25 );
            continue;
        }

        const HWND fg = GetForegroundWindow( );
        if ( fg != game_wnd && fg != my_wnd )
        {
            Sleep( 10 );
            continue;
        }

        overlay_detail::update_target_rect( );
        overlay_detail::update_mouse_input( );

        ImGui_ImplDX11_NewFrame( );
        ImGui_ImplWin32_NewFrame( );
        ImGui::NewFrame( );

        gameCache( );
        renderVisuals( );
        renderMenu( );

        ImGui::EndFrame( );
        overlay_detail::render_frame( );

        const HWND target = GetWindow( game_wnd, GW_HWNDPREV );
        SetWindowPos( my_wnd, target, 0, 0, 0, 0,
            SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE );
    }

    shutdown_overlay( );
    return messager.wParam;
}`,
