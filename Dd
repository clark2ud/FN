<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NIGHTHAWK — Developer Tools</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #090a0b;
  --surface: #0e1011;
  --surface-2: #121415;
  --border: #242729;
  --border-soft: #191c1e;
  --text: #f2f3f3;
  --muted: #858b8e;
  --dim: #555b5e;
  --accent: #d9ff62;
  --accent-dark: #a9cf38;
  --max: 1180px;
}
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
}
body {
  background: var(--bg);
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  overflow-x: hidden;
}
body::selection {
  background: var(--accent);
  color: #000;
}
a {
  color: inherit;
  text-decoration: none;
}
button {
  font: inherit;
}
.container {
  width: min(var(--max), calc(100% - 40px));
  margin: auto;
}
/* ---------------- NAV ---------------- */
nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  height: 72px;
  background: rgba(9,10,11,.86);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.nav-inner {
  height: 100%;
  width: min(var(--max), calc(100% - 40px));
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  letter-spacing: -.02em;
}
.logo-mark {
  width: 25px;
  height: 25px;
  border: 1px solid var(--accent);
  display: grid;
  place-items: center;
  font-family: "JetBrains Mono", monospace;
  font-size: 11px;
  color: var(--accent);
}
.nav-links {
  display: flex;
  gap: 30px;
  color: var(--muted);
  font-size: 13px;
}
.nav-links a {
  transition: color .2s ease;
}
.nav-links a:hover {
  color: var(--text);
}
.nav-action {
  border: 1px solid var(--border);
  padding: 9px 15px;
  font-size: 13px;
  transition: .2s ease;
}
.nav-action:hover {
  border-color: var(--accent);
  color: var(--accent);
}
/* ---------------- HERO ---------------- */
.hero {
  min-height: 92vh;
  display: flex;
  align-items: center;
  position: relative;
  padding: 150px 0 100px;
  overflow: hidden;
}
.hero::before {
  content: "";
  position: absolute;
  width: 650px;
  height: 650px;
  top: -300px;
  left: 50%;
  transform: translateX(-50%);
  background: radial-gradient(
    circle,
    rgba(217,255,98,.075),
    transparent 65%
  );
  pointer-events: none;
}
.hero-grid {
  position: absolute;
  inset: 0;
  opacity: .22;
  background-image:
    linear-gradient(var(--border-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--border-soft) 1px, transparent 1px);
  background-size: 72px 72px;
  mask-image: linear-gradient(to bottom, black, transparent 80%);
  pointer-events: none;
}
.hero-content {
  position: relative;
  max-width: 850px;
}
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: var(--muted);
  font-family: "JetBrains Mono", monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .12em;
  margin-bottom: 28px;
}
.eyebrow-dot {
  width: 6px;
  height: 6px;
  background: var(--accent);
  border-radius: 50%;
  box-shadow: 0 0 12px rgba(217,255,98,.5);
}
.hero h1 {
  max-width: 850px;
  font-size: clamp(52px, 8vw, 104px);
  line-height: .94;
  letter-spacing: -.065em;
  font-weight: 700;
}
.hero h1 span {
  color: var(--accent);
}
.hero-description {
  max-width: 570px;
  margin-top: 30px;
  color: var(--muted);
  line-height: 1.7;
  font-size: 16px;
}
.hero-actions {
  display: flex;
  gap: 10px;
  margin-top: 34px;
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 45px;
  padding: 0 20px;
  border: 1px solid var(--border);
  font-size: 13px;
  font-weight: 600;
  transition: .2s ease;
}
.button-primary {
  background: var(--accent);
  color: #080909;
  border-color: var(--accent);
}
.button-primary:hover {
  background: #e6ff91;
  transform: translateY(-1px);
}
.button-secondary:hover {
  border-color: #44494b;
  background: var(--surface);
}
.hero-meta {
  display: flex;
  gap: 35px;
  margin-top: 55px;
}
.meta-item {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.meta-value {
  font-size: 20px;
  font-weight: 600;
}
.meta-label {
  color: var(--dim);
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .08em;
}
/* ---------------- DIVIDER ---------------- */
.divider {
  border-top: 1px solid var(--border);
}
/* ---------------- SECTION ---------------- */
section {
  padding: 110px 0;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 45px;
  gap: 30px;
}
.section-number {
  color: var(--accent);
  font-family: "JetBrains Mono", monospace;
  font-size: 11px;
  margin-bottom: 13px;
}
.section-title {
  font-size: 38px;
  letter-spacing: -.045em;
}
.section-description {
  max-width: 390px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.65;
}
/* ---------------- PRODUCTS ---------------- */
.products {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}
.product {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 30px;
  min-height: 410px;
  display: flex;
  flex-direction: column;
  transition:
    transform .25s ease,
    border-color .25s ease,
    background .25s ease;
}
.product:hover {
  transform: translateY(-3px);
  border-color: #3a3f41;
  background: var(--surface-2);
}
.product-label {
  color: var(--accent);
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
}
.product h3 {
  font-size: 25px;
  letter-spacing: -.035em;
  margin-top: 14px;
}
.product-description {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.65;
  margin-top: 11px;
  max-width: 470px;
}
.features {
  list-style: none;
  margin-top: 25px;
  display: grid;
  gap: 9px;
}
.features li {
  color: #aeb3b5;
  font-size: 12px;
  display: flex;
  align-items: center;
  gap: 9px;
}
.features li::before {
  content: "";
  width: 5px;
  height: 5px;
  background: var(--accent);
  flex-shrink: 0;
}
.product-bottom {
  margin-top: auto;
  padding-top: 30px;
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
}
.price {
  font-size: 29px;
  font-weight: 600;
}
.price small {
  color: var(--dim);
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  font-weight: 400;
}
.product-button {
  min-width: 105px;
}
/* ---------------- FEATURE BAR ---------------- */
.feature-bar {
  background: #0c0e0f;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.feature {
  padding: 35px 30px;
  border-right: 1px solid var(--border);
}
.feature:first-child {
  padding-left: 0;
}
.feature:last-child {
  border-right: 0;
}
.feature-number {
  color: var(--accent);
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
}
.feature h4 {
  margin-top: 13px;
  font-size: 15px;
}
.feature p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
  margin-top: 7px;
  max-width: 260px;
}
/* ---------------- FAQ ---------------- */
.faq {
  max-width: 800px;
}
details {
  border-top: 1px solid var(--border);
}
details:last-child {
  border-bottom: 1px solid var(--border);
}
summary {
  list-style: none;
  cursor: pointer;
  padding: 22px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  font-weight: 600;
}
summary::-webkit-details-marker {
  display: none;
}
summary::after {
  content: "+";
  color: var(--muted);
  font-family: "JetBrains Mono", monospace;
  font-size: 18px;
  transition: transform .2s ease;
}
details[open] summary::after {
  transform: rotate(45deg);
  color: var(--accent);
}
details p {
  max-width: 680px;
  padding: 0 40px 22px 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}
/* ---------------- FOOTER ---------------- */
footer {
  border-top: 1px solid var(--border);
  padding: 55px 0;
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 40px;
}
.footer-brand {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}
.footer-links {
  display: flex;
  gap: 25px;
  color: var(--muted);
  font-size: 12px;
}
.footer-links a:hover {
  color: var(--text);
}
.footer-bottom {
  margin-top: 50px;
  color: var(--dim);
  font-family: "JetBrains Mono", monospace;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .08em;
}
/* ---------------- MOBILE ---------------- */
@media (max-width: 760px) {
  .nav-links {
    display: none;
  }
  .hero {
    min-height: auto;
    padding: 135px 0 90px;
  }
  .hero h1 {
    font-size: clamp(48px, 15vw, 78px);
  }
  .hero-meta {
    gap: 22px;
    flex-wrap: wrap;
  }
  .products {
    grid-template-columns: 1fr;
  }
  .feature-grid {
    grid-template-columns: 1fr;
  }
  .feature {
    border-right: 0;
    border-bottom: 1px solid var(--border);
    padding: 28px 0;
  }
  .feature:last-child {
    border-bottom: 0;
  }
  .section-header {
    display: block;
  }
  .section-description {
    margin-top: 15px;
  }
  .footer-inner {
    flex-direction: column;
  }
  .footer-links {
    flex-wrap: wrap;
  }
}
@media (max-width: 450px) {
  .container,
  .nav-inner {
    width: min(100% - 28px, var(--max));
  }
  .nav-action {
    display: none;
  }
  .hero-actions {
    flex-direction: column;
  }
  .button {
    width: 100%;
  }
  .product {
    padding: 23px;
  }
}
</style>
</head>
