// syntax highlighting with proper word boundaries
function highlight(code) {
  let escaped = code
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");

  // comments
  escaped = escaped.replace(/(\/\/[^\n]*)/g, '<span class="cm">$1</span>');
  escaped = escaped.replace(/(--[^\n]*)/g, '<span class="cm">$1</span>');
  // strings
  escaped = escaped.replace(/("(?:[^"\\]|\\.)*")/g, '<span class="str">$1</span>');
  // preprocessor
  escaped = escaped.replace(/^(#.*)$/gm, '<span class="kw">$1</span>');
  // keywords — using word boundaries properly
  escaped = escaped.replace(/\b(struct|class|inline|const|constexpr|static|void|bool|int|float|double|char|auto|return|if|else|for|while|switch|case|break|continue|new|delete|this|true|false|nullptr|using|namespace|template|typename|public|private|protected|virtual|override|operator|sizeof|reinterpret_cast|static_cast|include|pragma|uintptr_t|uint8_t|uint32_t|uint64_t|local|function|end|then|elseif|do|and|or|not|nil|in|repeat|until)\b/g, '<span class="kw">$1</span>');
  // types
  escaped = escaped.replace(/\b(Vector2|Vector3|Camera|FQuat|FTransform|D3DMATRIX|_MATRIX|ImVec2|ImColor|ImDrawList|ImU32|HRESULT|HWND|HANDLE|DWORD|UINT|WPARAM|LPARAM|BOOL|FLOAT|MSG|MARGINS|RECT|POINT|LONG_PTR|FNRot)\b/g, '<span class="kw">$1</span>');
  // functions
  escaped = escaped.replace(/\b(read|write|FindProcess|SetupDriver|GetBase|BypassCR3|getCamera|PW2S|getEntityBone|is_visible|calculate_angle|normalize_angle|smooth_aim|select_target|in_fov|draw_esp_box|draw_skeleton|hijack_window|apply_window_surface|render_loop|renderMenu|renderVisuals|gameCache|get_process_wnd|ToMatrixWithScale|MatrixMultiplication|Matrix|dot|distance|atan2f|atan2|asin|sin|cos|tanf|sqrtf|fmax|hypot|printf|exit|Sleep|FindWindowA|FindWindowW|GetWindowLongPtrA|SetWindowLongPtrA|SetLayeredWindowAttributes|UpdateWindow|ShowWindow|DwmExtendFrameIntoClientArea|PeekMessage|TranslateMessage|DispatchMessage|GetForegroundWindow|IsWindow|GetAsyncKeyState|GetWindow|SetWindowPos|GetClientRect|ClientToScreen|GetCursorPos|ScreenToClient|Connect)\b/g, '<span class="num">$1</span>');
  // imgui
  escaped = escaped.replace(/\b(ImGui::[A-Za-z]+|ImGui_Impl[A-Za-z_]+)\b/g, '<span class="num">$1</span>');
  // numbers
  escaped = escaped.replace(/\b(0x[0-9A-Fa-f]+|\d+\.?\d*f?)\b/g, '<span class="num">$1</span>');

  return escaped;
}

// dom refs
const selection = document.getElementById("selection");
const documentation = document.getElementById("documentation");
const content = document.getElementById("docs-content");
const docsHeading = document.getElementById("docs-heading");
const docsDescription = document.getElementById("docs-description");
const docsLabel = document.getElementById("docs-game-label");
const docsEyebrow = document.getElementById("docs-eyebrow");
const sidebarLinks = document.getElementById("sidebar-links");
const backButton = document.getElementById("back-btn");
const logo = document.getElementById("logo");

let currentGame = null;

function showView(view) {
  selection.classList.toggle("active", view === "selection");
  documentation.classList.toggle("active", view === "documentation");
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function renderSidebar(sections) {
  sidebarLinks.innerHTML = "";
  sections.forEach((section, index) => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "side-link" + (index === 0 ? " active" : "");
    btn.dataset.target = section.id;
    btn.textContent = section.title;
    btn.addEventListener("click", () => {
      document.querySelectorAll(".side-link").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      const target = document.getElementById(section.id);
      if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    sidebarLinks.appendChild(btn);
  });
}

async function copyCode(button, code) {
  try {
    await navigator.clipboard.writeText(code);
    button.textContent = "copied";
    button.classList.add("copied");
    setTimeout(() => {
      button.textContent = "copy";
      button.classList.remove("copied");
    }, 1200);
  } catch {
    button.textContent = "failed";
    setTimeout(() => { button.textContent = "copy"; }, 1200);
  }
}

function renderDocs(gameKey) {
  const game = templates[gameKey];
  if (!game) return;
  currentGame = gameKey;

  docsHeading.textContent = game.title;
  docsDescription.textContent = game.description;
  docsLabel.textContent = game.label;
  docsEyebrow.textContent = game.label + " / DOCS";

  content.innerHTML = "";
  renderSidebar(game.sections);

  game.sections.forEach(section => {
    const sectionEl = document.createElement("section");
    sectionEl.className = "docs-section";
    sectionEl.id = section.id;
    sectionEl.innerHTML = `
      <div class="section-kicker">${section.kicker}</div>
      <h2>${section.title}</h2>
      <p class="section-desc">${section.description}</p>
    `;

    section.blocks.forEach(block => {
      const blockEl = document.createElement("article");
      blockEl.className = "doc-block";

      blockEl.innerHTML = `
        <div class="block-header">
          <div class="block-title">${block.title}</div>
          <span class="block-lang">${block.language}</span>
        </div>
        <div class="code-card">
          <div class="code-header">
            <div class="code-dots"><span></span><span></span><span></span></div>
            <button class="copy-btn" type="button">copy</button>
          </div>
          <pre><code>${highlight(block.code)}</code></pre>
        </div>
        <div class="explanation">
          <div class="explanation-title">// what it does</div>
          <p>${block.description}</p>
          <ul>
            ${block.points.map(p => `<li>${p}</li>`).join("")}
          </ul>
        </div>
      `;

      const copyBtn = blockEl.querySelector(".copy-btn");
      copyBtn.addEventListener("click", () => copyCode(copyBtn, block.code));

      sectionEl.appendChild(blockEl);
    });

    content.appendChild(sectionEl);
  });

  showView("documentation");
  setupScrollSpy();
}

function setupScrollSpy() {
  const sectionEls = document.querySelectorAll(".docs-section");
  const links = document.querySelectorAll(".side-link");
  if (!sectionEls.length) return;

  const observer = new IntersectionObserver(entries => {
    const visible = entries
      .filter(e => e.isIntersecting)
      .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
    if (!visible.length) return;
    const activeId = visible[0].target.id;
    links.forEach(link => {
      link.classList.toggle("active", link.dataset.target === activeId);
    });
  }, { rootMargin: "-15% 0px -65% 0px", threshold: [0, 0.1, 0.25, 0.5] });

  sectionEls.forEach(s => observer.observe(s));
}

// events
document.querySelectorAll(".game-card").forEach(card => {
  card.addEventListener("click", () => renderDocs(card.dataset.game));
});

backButton.addEventListener("click", () => showView("selection"));
logo.addEventListener("click", e => { e.preventDefault(); showView("selection"); });
</script>
