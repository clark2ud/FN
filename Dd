<script>
const sections = [
  {
    id: "prereqs",
    kicker: "01 / PREREQUISITES",
    title: "What You Need to Know First",
    description: "Before touching any code, you need to understand three things: what memory looks like, what a pointer is, and how 3D coordinates work. If you already know this, skip ahead. If not, read carefully — everything else builds on this.",
    blocks: [
      {
        title: "How Game Memory Works",
        language: "concept",
        code: `// every program gets its own chunk of ram
// that chunk is just a giant array of bytes

// fortnite's memory looks something like:
[0x00000000]  ... header stuff
[0x10000000]  game code (the .exe)
[0x20000000]  game data (entities, positions, health)
[0x30000000]  graphics stuff (meshes, textures)
[...]

// each [slot] is one byte (8 bits, 0-255)
// we read groups of bytes to get useful values

// 4 bytes together = an int (like health: 100)
// 4 bytes together = a float (like position: 1523.47)
// 8 bytes together = a pointer (address to another location)`,
        description: "When Fortnite runs, Windows gives it a massive block of memory. That block is just bytes — millions of them. The game stores everything there: player positions, health, ammo, what skin you're wearing. An external cheat works by reading those bytes from outside the game process. We don't inject anything. We just look at the memory and draw what we see.",
        points: [
          "every value in the game lives at a specific address — a number like 0x2A7F3C80",
          "an address is just an index into the game's memory array",
          "4 bytes = int or float, 8 bytes = pointer (on 64-bit)",
          "our driver lets us read these bytes without the game knowing",
          "we never write — only read. that's what makes it 'external'"
        ]
      },
      {
        title: "What a Pointer Is",
        language: "concept",
        code: `// a pointer is just a variable that holds an address
// instead of holding a value, it points to where the value lives

// example:
// address 0x1000 contains the number 0x5000
// address 0x5000 contains the number 100

// so if we have a pointer at 0x1000:
// read 0x1000 → get 0x5000 (this is the pointer)
// read 0x5000 → get 100 (this is the actual value)

// in code:
uintptr_t ptr = read<uintptr_t>(0x1000);  // ptr = 0x5000
int health = read<int>(ptr);               // health = 100

// this is called "dereferencing" — following the pointer`,
        description: "Games don't store things in fixed locations. Your health isn't always at address 0x5000 — it moves every time the game runs. So the game uses pointers: variables that hold the address of other variables. To find your health, we read a pointer to get the address, then read that address to get the value. This is called a pointer chain, and it's how every external cheat navigates game memory.",
        points: [
          "pointer = a variable whose value is a memory address",
          "dereferencing = reading the address the pointer points to",
          "pointer chain = follow multiple pointers to reach the final value",
          "base address + offsets = how we navigate from the exe to any value",
          "if any pointer in the chain is null (0), the whole chain fails"
        ]
      },
      {
        title: "3D Coordinates",
        language: "concept",
        code: `// the game world is a 3D space
// every position is defined by three numbers:

// X = left/right (east/west)
// Y = forward/backward (north/south)  
// Z = up/down (height)

// your character might be at:
// X: 1523.47  (far east)
// Y: -284.12  (slightly south)
// Z: 102.00   (102 units above ground)

// the origin (0, 0, 0) is the center of the map
// distances are measured in "units" — roughly 1 unit = 1 cm

// to aim at someone, we need:
// 1. their position (where they are)
// 2. our camera position (where we are)
// 3. the angle between them (where to look)`,
        description: "Fortnite's world is a 3D Cartesian coordinate system. Every object — players, buildings, bullets — has a position defined by X, Y, and Z. To draw an ESP box on screen, we need to convert these 3D world coordinates into 2D screen pixels. That's what the world-to-screen function does later. But first, you need to understand that positions are just three floats stored in memory.",
        points: [
          "X, Y, Z — three floats define any position in the world",
          "origin (0,0,0) is the center of the map",
          "to draw on screen, we convert 3D world → 2D pixels",
          "the camera has its own position and rotation in this same space"
        ]
      }
    ]
  },
  {
    id: "math-types",
    kicker: "02 / MATH TYPES",
    title: "Vectors & Matrices",
    description: "These are the data types that represent 3D math. You need them before you can do anything useful. Don't skip this — every function later depends on understanding what these are.",
    blocks: [
      {
        title: "vector.h — Vector2",
        language: "C++",
        code: `struct Vector2
{
    double x{ 0.0 };
    double y{ 0.0 };

    constexpr Vector2( ) noexcept = default;

    constexpr Vector2( double x, double y ) noexcept
        : x( x ), y( y )
    {}
};`,
        description: "Vector2 represents a 2D position — a point on your screen. x is horizontal (0 = left edge, 1920 = right edge on a 1080p monitor), y is vertical (0 = top, 1080 = bottom). We use this for the output of world-to-screen: once we convert a 3D game position to 2D, we get a Vector2 that tells us where on screen to draw the ESP box.",
        points: [
          "screen coordinates: x goes left→right, y goes top→bottom",
          "doubles for precision — floats lose accuracy at large coordinates",
          "this is the FINAL output of w2s — where to draw on your monitor"
        ]
      },
      {
        title: "vector.h — Vector3",
        language: "C++",
        code: `struct Vector3
{
    double x{ 0.0 };
    double y{ 0.0 };
    double z{ 0.0 };

    constexpr Vector3( ) noexcept = default;

    constexpr Vector3( double x, double y, double z ) noexcept
        : x( x ), y( y ), z( z )
    {}

    // dot product: projects one vector onto another
    // returns how much they point in the same direction
    constexpr double dot( const Vector3& other ) const noexcept
    {
        return x * other.x + y * other.y + z * other.z;
    }

    // distance between two points in 3D space
    double distance( const Vector3& other ) const noexcept
    {
        return std::hypot( other.x - x, other.y - y, other.z - z );
    }

    // subtract: gives you the vector FROM other TO this
    constexpr Vector3 operator-( const Vector3& other ) const noexcept
    {
        return { x - other.x, y - other.y, z - other.z };
    }
};`,
        description: "Vector3 is the workhorse. It represents any position or direction in 3D space — player locations, bone positions, camera angles. The three functions here do everything we need: dot() projects one vector onto another (used in w2s), distance() tells you how far apart two things are (used for target selection), and operator- gives you the direction from one point to another (used in aim calculations).",
        points: [
          "dot() = multiply corresponding components and sum — used to project onto camera axes",
          "distance() = straight-line distance — 'closest target' logic uses this",
          "operator- = vector subtraction — gives direction and magnitude between two points",
          "all positions in the game are Vector3: player feet, player head, camera, bullets"
        ]
      },
      {
        title: "matrix.h — FTransform",
        language: "C++",
        code: `// a quaternion — represents rotation without gimbal lock
// four components: x, y, z, w
// don't worry about the math, just know it represents rotation
struct FQuat
{
    double x, y, z, w;
};

// how unreal engine stores a bone's position and rotation
// every bone in a character skeleton is one of these
struct FTransform
{
    FQuat rotation;          // which way the bone is facing
    Vector3 translation;     // where the bone is (relative to parent)
    uint8_t pad1c[ 0x8 ];    // padding — makes struct match memory layout
    Vector3 scale3d;         // bone size (usually 1,1,1)
    uint8_t pad2c[ 0x8 ];    // more padding
};`,
        description: "FTransform is how Unreal Engine (the engine Fortnite runs on) stores the position and rotation of every bone in a character's skeleton. Your character has bones: head, neck, spine, arms, legs. Each bone has an FTransform that says where it is relative to its parent bone. The padding bytes (pad1c, pad2c) aren't used — they're there to make our C++ struct match the exact memory layout the game uses, so when we read 0x60 bytes from memory, they land in the right places.",
        points: [
          "quaternion = rotation representation — four numbers instead of three angles",
          "translation = position offset from the parent bone",
          "padding bytes align the struct to match the game's memory exactly",
          "sizeof(FTransform) = 0x60 = 96 bytes — this is why we multiply bone_id by 0x60"
        ]
      },
      {
        title: "matrix.h — ToMatrixWithScale",
        language: "C++",
        code: `D3DMATRIX ToMatrixWithScale( )
{
    D3DMATRIX m{};  // 4x4 matrix, all zeros

    // if scale is 0, use 1 instead (prevents zeroing the matrix)
    const Vector3 Scale(
        ( scale3d.x == 0.0 ) ? 1.0 : scale3d.x,
        ( scale3d.y == 0.0 ) ? 1.0 : scale3d.y,
        ( scale3d.z == 0.0 ) ? 1.0 : scale3d.z
    );

    // expand quaternion into rotation matrix components
    // this is standard quaternion-to-matrix math
    const double x2 = rotation.x + rotation.x;
    const double y2 = rotation.y + rotation.y;
    const double z2 = rotation.z + rotation.z;
    const double xx2 = rotation.x * x2;
    const double yy2 = rotation.y * y2;
    const double zz2 = rotation.z * z2;
    // ... (full expansion in actual source)

    // translation goes in the bottom row
    m._41 = translation.x;
    m._42 = translation.y;
    m._43 = translation.z;
    m._44 = 1.0f;  // required for proper matrix math

    // rotation and scale fill the upper 3x3
    // ... (full rotation matrix in actual source)

    return m;
}`,
        description: "This converts an FTransform into a 4x4 matrix. Why? Because matrices can be multiplied together to combine transformations. If a bone is rotated 45 degrees and its parent is rotated 30 degrees, multiplying their matrices gives you the combined 75 degree rotation. The scale check prevents division by zero — if a bone has scale 0 (which happens with some attachments), we substitute 1 so the matrix doesn't collapse to nothing. The translation (position) goes in the bottom row (_41, _42, _43) because that's where 4x4 matrices store position.",
        points: [
          "quaternion → rotation matrix: expands 4 quaternion values into 9 matrix values",
          "scale of 0 → replaced with 1: prevents the entire matrix from becoming zero",
          "translation in bottom row: standard 4x4 matrix convention for position",
          "result is a D3DMATRIX: a 4x4 grid of floats that DirectX understands"
        ]
      },
      {
        title: "matrix.h — MatrixMultiplication",
        language: "C++",
        code: `inline D3DMATRIX MatrixMultiplication( D3DMATRIX pm1, D3DMATRIX pm2 )
{
    D3DMATRIX pout{};

    // each element is the dot product of a row from pm1
    // and a column from pm2
    pout._11 = pm1._11 * pm2._11 + pm1._12 * pm2._21 
             + pm1._13 * pm2._31 + pm1._14 * pm2._41;
    pout._12 = pm1._11 * pm2._12 + pm1._12 * pm2._22 
             + pm1._13 * pm2._32 + pm1._14 * pm2._42;
    // ... (14 more elements, same pattern)
    pout._44 = pm1._41 * pm2._14 + pm1._42 * pm2._24 
             + pm1._43 * pm2._34 + pm1._44 * pm2._44;

    return pout;
}`,
        description: "Standard 4x4 matrix multiplication. Each output element is computed by taking a row from the first matrix, a column from the second, multiplying corresponding elements, and summing. We use this to combine two transformations: the bone's local transform (relative to its parent) with the mesh's component-to-world transform (relative to the game world). The result is the bone's position in world space — which we can then project to screen.",
        points: [
          "row × column, multiply and sum — that's all matrix multiplication is",
          "order matters: A×B ≠ B×A — we do bone first, then component",
          "result: bone's final position in world coordinates",
          "this is how a local bone position becomes a world position"
        ]
      },
      {
        title: "matrix.h — Rotation Matrix from Euler Angles",
        language: "C++",
        code: `inline _MATRIX Matrix( Vector3 rot, Vector3 origin = Vector3( 0,0,0 ) )
{
    // convert degrees to radians — trig functions need radians
    double radPitch = ( rot.x * M_PI / 180.0 );
    double radYaw   = ( rot.y * M_PI / 180.0 );
    double radRoll  = ( rot.z * M_PI / 180.0 );

    // compute sin/cos once, reuse everywhere
    double SP = sin( radPitch ), CP = cos( radPitch );
    double SY = sin( radYaw ),   CY = cos( radYaw );
    double SR = sin( radRoll ),  CR = cos( radRoll );

    _MATRIX matrix;

    // first row: combines pitch and yaw
    matrix.m[ 0 ][ 0 ] = CP * CY;
    matrix.m[ 0 ][ 1 ] = CP * SY;
