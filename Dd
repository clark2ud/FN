<script>
const templates = {
fortnite: {
  label: "FORTNITE",
  title: "Fortnite External",
  description: "From zero to working cheat. Every function fully implemented.",
  sections: [
    {
      id: "prereqs",
      kicker: "01 / PREREQUISITES",
      title: "Before You Write Code",
      description: "Three concepts you need: memory, pointers, 3D space. Everything builds on these.",
      blocks: [
        {
          title: "How Memory Works",
          language: "concept",
          code: `// fortnite gets a giant block of ram when it runs
// that block is just bytes — millions of them

// layout looks something like:
[0x10000000]  game code (.exe)
[0x20000000]  game data (players, positions, health)
[0x30000000]  graphics (meshes, textures)

// we read bytes from outside the game — that's "external"
// 4 bytes = int or float, 8 bytes = pointer, 24 bytes = Vector3`,
          description: "The game stores everything in RAM — positions, health, ammo. We read those bytes from a separate process using the driver. No injection, just reading.",
          points: [
            "every value lives at an address like 0x2A7F3C80",
            "4 bytes = int/float, 8 bytes = pointer, 24 bytes = 3 doubles",
            "external = read-only, the game doesn't know we exist"
          ]
        },
        {
          title: "Pointers",
          language: "concept",
          code: `// a pointer holds an address instead of a value
// address 0x1000 contains 0x5000
// address 0x5000 contains 100 (the actual value)

// to read it:
uintptr_t ptr = ClarkDtcDriver::read<uintptr_t>( 0x1000 );  // = 0x5000
int health = ClarkDtcDriver::read<int>( ptr );               // = 100

// games use chains of these because objects move around
// base + offset → pointer → + offset → pointer → + offset → value`,
          description: "Nothing useful stays at a fixed address. Games chain pointers: each pointer leads to the next object. Follow the chain to find any value.",
          points: [
            "pointer = variable holding a memory address",
            "dereferencing = reading the address the pointer points to",
            "chain = follow pointers step by step until you reach the value",
            "if any pointer is 0, the chain is broken"
          ]
        },
        {
          title: "3D Coordinates",
          language: "concept",
          code: `// the game world is 3D space
// every position = three numbers:

// X = left/right (east/west)
// Y = forward/back (north/south)
// Z = up/down (height)

// origin (0,0,0) = center of map
// to aim at someone we need:
// 1. their position (Vector3)
// 2. our camera position (Vector3)
// 3. the angle between (calculated later)`,
          description: "Every object in Fortnite has an X, Y, Z position. To draw on screen we convert these 3D world coordinates to 2D pixels later.",
          points: [
            "X, Y, Z = three floats define any position",
            "origin (0,0,0) = map center",
            "we convert 3D world → 2D screen for ESP"
          ]
        }
      ]
    },
    {
      id: "math",
      kicker: "02 / MATH",
      title: "Vectors & Matrices",
      description: "The data types for 3D math. You need these before anything else.",
      blocks: [
        {
          title: "Vector2 & Vector3",
          language: "C++",
          code: `struct Vector2
{
    double x{ 0.0 };
    double y{ 0.0 };

    constexpr Vector2( ) noexcept = default;
    constexpr Vector2( double x, double y ) noexcept
        : x( x ), y( y )
    {}
};

struct Vector3
{
    double x{ 0.0 };
    double y{ 0.0 };
    double z{ 0.0 };

    constexpr Vector3( ) noexcept = default;
    constexpr Vector3( double x, double y, double z ) noexcept
        : x( x ), y( y ), z( z )
    {}

    constexpr double dot( const Vector3& o ) const noexcept
    {
        return x * o.x + y * o.y + z * o.z;
    }

    double distance( const Vector3& o ) const noexcept
    {
        return std::hypot( o.x - x, o.y - y, o.z - z );
    }

    constexpr Vector3 operator-( const Vector3& o ) const noexcept
    {
        return { x - o.x, y - o.y, z - o.z };
    }
};`,
          description: "Vector2 = screen position (pixels). Vector3 = world position (game units). dot() projects onto axes, distance() measures gap, operator- gives direction between points.",
          points: [
            "Vector2: x = horizontal pixels, y = vertical pixels",
            "Vector3: x/y/z position in 3D world space",
            "dot(): project one vector onto another — used in w2s",
            "distance(): how far apart two things are",
            "operator-: direction vector from one point to another"
          ]
        },
        {
          title: "FTransform & Quaternion",
          language: "C++",
          code: `struct FQuat
{
    double x, y, z, w;
};

struct FTransform
{
    FQuat rotation;
    Vector3 translation;
    uint8_t pad1c[ 0x8 ];
    Vector3 scale3d;
    uint8_t pad2c[ 0x8 ];
};`,
          description: "FTransform = how Unreal Engine stores bone data. Rotation as quaternion (4 numbers), position as vector (3 numbers), scale as vector. Padding matches the game's exact memory layout.",
          points: [
            "quaternion = rotation without gimbal lock (4 values)",
            "translation = position relative to parent bone",
            "padding bytes align struct to match game memory exactly",
            "sizeof(FTransform) = 0x60 = 96 bytes per bone"
          ]
        },
        {
          title: "ToMatrixWithScale",
          language: "C++",
          code: `D3DMATRIX ToMatrixWithScale( )
{
    D3DMATRIX m{};

    const Vector3 Scale(
        ( scale3d.x == 0.0 ) ? 1.0 : scale3d.x,
        ( scale3d.y == 0.0 ) ? 1.0 : scale3d.y,
        ( scale3d.z == 0.0 ) ? 1.0 : scale3d.z
    );

    const double x2 = rotation.x + rotation.x;
    const double y2 = rotation.y + rotation.y;
    const double z2 = rotation.z + rotation.z;
    const double xx2 = rotation.x * x2;
    const double yy2 = rotation.y * y2;
    const double zz2 = rotation.z * z2;
    const double yz2 = rotation.y * z2;
    const double wx2 = rotation.w * x2;
    const double xy2 = rotation.x * y2;
    const double wz2 = rotation.w * z2;
    const double xz2 = rotation.x * z2;
    const double wy2 = rotation.w * y2;

    m._41 = translation.x;
    m._42 = translation.y;
    m._43 = translation.z;
    m._11 = ( 1.0f - ( yy2 + zz2 ) ) * Scale.x;
    m._22 = ( 1.0f - ( xx2 + zz2 ) ) * Scale.y;
    m._33 = ( 1.0f - ( xx2 + yy2 ) ) * Scale.z;
    m._32 = ( yz2 - wx2 ) * Scale.z;
    m._23 = ( yz2 + wx2 ) * Scale.y;
    m._21 = ( xy2 - wz2 ) * Scale.y;
    m._12 = ( xy2 + wz2 ) * Scale.x;
    m._31 = ( xz2 + wy2 ) * Scale.z;
    m._13 = ( xz2 - wy2 ) * Scale.x;
    m._14 = 0.0f;
    m._24 = 0.0f;
    m._34 = 0.0f;
    m._44 = 1.0f;

