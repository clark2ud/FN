    // add tool window style (hides from taskbar and alt-tab)
    SetWindowLongPtrA( hwnd, GWL_EXSTYLE, 
        style | WS_EX_LAYERED | WS_EX_TOOLWINDOW );

    // make black fully transparent
    // anything we draw in black will be invisible
    // anything not black will show on top of the game
    SetLayeredWindowAttributes( hwnd, RGB( 0,0,0 ), 255, LWA_ALPHA );

    UpdateWindow( hwnd );
    ShowWindow( hwnd, SW_SHOW );
}`,
