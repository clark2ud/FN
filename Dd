<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>evvls — dev docs</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #08080a;
  --bg-elev: #0e0e12;
  --bg-card: #121218;
  --bg-hover: #181822;
  --border: rgba(255,255,255,.06);
  --border-hi: rgba(255,255,255,.12);
  --text: #e8e8ec;
  --text-dim: rgba(232,232,236,.55);
  --text-mute: rgba(232,232,236,.35);
  --accent: #c4b5fd;
  --accent-dim: rgba(196,181,253,.15);
  --green: #6ee7b7;
  --green-dim: rgba(110,231,183,.12);
  --amber: #fbbf24;
  --red: #f87171;
  --mono: 'JetBrains Mono', monospace;
  --sans: 'Inter', -apple-system, sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
::selection { background: var(--accent-dim); color: var(--accent); }

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,.03) 2px, rgba(0,0,0,.03) 4px);
  pointer-events: none;
  z-index: 9999;
}

.app { max-width: 1100px; margin: 0 auto; padding: 0 24px; }

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 0;
  border-bottom: 1px solid var(--border);
}
.logo {
  font-family: var(--mono);
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
}
.logo::before { content: '>'; color: var(--accent); }
.logo span { color: var(--accent); }
.header-right {
  display: flex;
  align-items: center;
  gap: 16px;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text-mute);
}
.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 6px var(--green);
  animation: pulse 2s infinite;
}
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .4; } }
.header-status { display: flex; align-items: center; gap: 6px; }
.viewer-count {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border: 1px solid var(--border);
  border-radius: 4px;
}
.viewer-count::before {
  content: '👁';
  font-size: 10px;
}

/* views */
.view { display: none; }
.view.active { display: block; animation: fadeUp .35s ease; }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* selection view */
.hero { padding: 80px 0 60px; border-bottom: 1px solid var(--border); }
.hero-tag {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--accent);
  letter-spacing: 2px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.hero-tag::before { content: ''; width: 20px; height: 1px; background: var(--accent); }
h1 {
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 800;
  letter-spacing: -2.5px;
  line-height: .95;
  margin-bottom: 20px;
}
h1 .dim { color: var(--text-mute); }
.hero-desc {
  font-size: 14px;
  color: var(--text-dim);
  max-width: 480px;
  line-height: 1.7;
  margin-bottom: 32px;
}
.hero-meta {
  display: flex;
  gap: 24px;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text-mute);
}
.hero-meta span { display: flex; align-items: center; gap: 5px; }
.hero-meta span::before { content: '//'; color: var(--accent); opacity: .5; }

/* game grid */
.game-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  margin: 48px 0;
}
.game-card {
  background: var(--bg-elev);
  border: none;
  padding: 32px;
  text-align: left;
  cursor: pointer;
  color: var(--text);
  font-family: inherit;
  position: relative;
  overflow: hidden;
  transition: background .2s;
}
.game-card:hover { background: var(--bg-hover); }
.game-card::after {
  content: '→';
  position: absolute;
  right: 24px;
  bottom: 24px;
  font-size: 16px;
  color: var(--text-mute);
  transition: all .2s;
}
.game-card:hover::after { color: var(--accent); transform: translateX(3px); }
.game-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 700;
  background: var(--accent-dim);
  color: var(--accent);
  border-radius: 6px;
  margin-bottom: 20px;
}
.game-card h2 {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -.5px;
  margin-bottom: 8px;
}
.game-card p {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--text-dim);
  line-height: 1.6;
}
.card-meta {
  display: flex;
  gap: 12px;
  margin-top: 16px;
  font-family: var(--mono);
  font-size: 9px;
  color: var(--text-mute);
}
.tag {
  padding: 3px 7px;
  border: 1px solid var(--border);
  border-radius: 3px;
}
.tag.active { color: var(--green); border-color: rgba(110,231,183,.2); background: var(--green-dim); }

/* notice */
.notice-box {
  margin: 32px 0;
  padding: 16px 20px;
  border: 1px solid rgba(196,181,253,.2);
  background: var(--accent-dim);
  border-radius: 8px;
}
.notice-box p {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--accent);
  line-height: 1.8;
}
.notice-box a { color: var(--text); text-decoration: underline; text-underline-offset: 2px; }

/* docs layout */
.docs-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
  margin-bottom: 32px;
}
.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: 1px solid var(--border);
  color: var(--text-dim);
  padding: 6px 12px;
  border-radius: 5px;
  font-family: var(--mono);
  font-size: 10px;
  cursor: pointer;
  transition: all .15s;
}
.back-btn:hover { color: var(--text); border-color: var(--border-hi); }
.docs-label {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text-mute);
  letter-spacing: 1px;
}

.docs-layout {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 40px;
  padding: 0 0 60px;
}
.sidebar { position: sticky; top: 24px; align-self: start; }
.sidebar-label {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--text-mute);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}
.sidebar button {
  display: block;
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  border-left: 2px solid var(--border);
  color: var(--text-dim);
  padding: 8px 12px;
  font-family: var(--mono);
  font-size: 10px;
  cursor: pointer;
  transition: all .15s;
}
.sidebar button:hover { color: var(--text); }
.sidebar button.active {
  color: var(--accent);
  border-left-color: var(--accent);
  background: var(--accent-dim);
}

.docs-title { margin-bottom: 48px; }
.docs-title h1 {
  font-size: clamp(28px, 4vw, 42px);
  letter-spacing: -1.5px;
  margin-bottom: 12px;
}
.docs-title p {
  font-size: 13px;
  color: var(--text-dim);
  line-height: 1.7;
  max-width: 520px;
}

.docs-section { scroll-margin-top: 32px; margin-bottom: 64px; }
.section-kicker {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--accent);
  letter-spacing: 2px;
  margin-bottom: 10px;
}
.docs-section h2 {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -.5px;
  margin-bottom: 10px;
}
.section-desc {
  font-size: 13px;
  color: var(--text-dim);
  line-height: 1.7;
  margin-bottom: 32px;
  max-width: 520px;
}

.doc-block { margin-bottom: 40px; }
.block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.block-title { font-size: 14px; font-weight: 600; }
.block-lang {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--text-mute);
  padding: 2px 7px;
  border: 1px solid var(--border);
  border-radius: 3px;
}
.code-card {
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  background: #0a0a0e;
}
.code-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 14px;
  background: var(--bg-elev);
  border-bottom: 1px solid var(--border);
}
.code-dots { display: flex; gap: 5px; }
.code-dots span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--border-hi);
}
.code-dots span:first-child { background: rgba(248,113,113,.4); }
.code-dots span:nth-child(2) { background: rgba(251,191,36,.4); }
.code-dots span:last-child { background: rgba(110,231,183,.4); }
.copy-btn {
  background: none;
  border: 1px solid var(--border);
  color: var(--text-mute);
  padding: 3px 8px;
  border-radius: 3px;
  font-family: var(--mono);
  font-size: 9px;
  cursor: pointer;
  transition: all .15s;
}
.copy-btn:hover { color: var(--text); border-color: var(--border-hi); }
.copy-btn.copied { color: var(--green); border-color: rgba(110,231,183,.3); }
pre {
  overflow-x: auto;
  padding: 16px 20px;
  font-family: var(--mono);
  font-size: 11.5px;
  line-height: 1.7;
  color: #c8c8d4;
  tab-size: 2;
  max-height: 400px;
  overflow-y: auto;
}
pre .kw { color: var(--accent); }
pre .str { color: var(--green); }
pre .num { color: var(--amber); }
pre .cm { color: var(--text-mute); font-style: italic; }

.explanation {
  margin-top: 12px;
  padding: 16px 20px;
  border-left: 2px solid var(--accent);
  background: var(--bg-elev);
  border-radius: 0 8px 8px 0;
}
.explanation-title {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--accent);
  margin-bottom: 8px;
}
.explanation p {
  font-size: 12px;
  color: var(--text-dim);
  line-height: 1.7;
  margin-bottom: 10px;
}
.explanation p:last-child { margin-bottom: 0; }
.explanation ul { list-style: none; padding: 0; margin-top: 8px; }
.explanation li {
  font-family: var(--mono);
  font-size: 10.5px;
  color: var(--text-mute);
  line-height: 1.8;
  padding-left: 14px;
  position: relative;
  margin-bottom: 4px;
}
.explanation li::before {
  content: '→';
  position: absolute;
  left: 0;
  color: var(--accent);
  font-size: 10px;
}

footer {
  padding: 32px 0 24px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text-mute);
}

@media (max-width: 700px) {
  .app { padding: 0 16px; }
  .hero { padding: 48px 0 40px; }
  .docs-layout { grid-template-columns: 1fr; gap: 24px; }
  .sidebar { position: static; }
  .sidebar > div { display: flex; overflow-x: auto; gap: 4px; padding-bottom: 6px; }
  .sidebar-label { display: none; }
  .sidebar button { white-space: nowrap; border-left: none; border-bottom: 2px solid var(--border); }
  .sidebar button.active { border-bottom-color: var(--accent); }
  .game-grid { grid-template-columns: 1fr; }
  pre { font-size: 10.5px; padding: 12px 14px; }
}
</style>
</head>
